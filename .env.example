ENVIRONMENT=dev
DRIVER=~fastapi+~httpx+~websockets
HOST=127.0.0.1
PORT=27315

# 与 NapCat 反向 WS 中填写的 token 保持一致（可留空，建议设置）
ONEBOT_ACCESS_TOKEN=change-me

# LLM 通道：relay=中转站（推荐）
LLM_PROVIDER=relay

# OpenAI 兼容中转站
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://your-relay.example/v1
OPENAI_MODEL=gpt-5.6-sol

# 本地 Ollama 不再自动回退；仅当手动设 LLM_PROVIDER=ollama 时生效
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# 学姐插件
DL_SENPAI_INTERRUPT_PROB=0.10
DL_SENPAI_INTERRUPT_COOLDOWN=90
# 刚 @ 学姐后，多少秒内再发表情包也算找她
DL_SENPAI_STICKER_FOLLOWUP_SEC=60
DL_SENPAI_MIN_MSG_LEN=8
# 0 = 不按条数裁剪（条数另由 DL_SENPAI_MEMORY_RECENT_TURNS 控制）
DL_SENPAI_MAX_HISTORY=0
# 喂给模型的历史字符预算（0 = 不限）。条数和字符两道闸都要有：
# 有人贴一段报错日志，一条就上万字，24 条照样能把上下文塞满。
# 只影响「读给模型」，不会删磁盘上的聊天记录。
DL_SENPAI_HISTORY_MAX_CHARS=12000
# 重复消息去重：NapCat 断线重连会重放没 ack 的事件，
# 不去重她会对着同一句话回两遍。窗口内同一 message_id 只处理一次。
DL_SENPAI_DEDUPE_ENABLE=true
DL_SENPAI_DEDUPE_WINDOW_SEC=300
DL_SENPAI_DEDUPE_MAX_ITEMS=512
# 本轮语气判定（吐槽 / 真倾诉）：判定结果会贴到提示词最末。
# 实测对「真倾诉」有效（安慰率 22%→55%），对「吐槽」无效（都是 33%）——
# 后者只记录到日志 llm.comfort_leak，不再做后置改写。
DL_SENPAI_TONE_CLASSIFY_ENABLE=true
# 温度：1.1 左右最像真人。调低（0.8 以下）措辞会变得像客服模板。
DL_SENPAI_TEMPERATURE=1.1
DL_SENPAI_MAX_TOKENS=1600
DL_SENPAI_INTERRUPT_MAX_TOKENS=200
DL_SENPAI_REPLY_MAX_CHARS=1500
# 超过 REPLY_MAX_CHARS 时用合并转发（聊天记录），每段约这么长
DL_SENPAI_REPLY_CHUNK_CHARS=900
# 正文超过这个字数改用合并转发（聊天记录卡片）：连发气泡刷屏，单条又读不下去。0 = 关闭
DL_SENPAI_FORWARD_MIN_CHARS=400
# 合并转发里每一节的字数上限：手机上超过这个长度要滑好几屏
DL_SENPAI_FORWARD_NODE_CHARS=600
# 绝对硬上限，只防模型跑飞把整段话灌进群里。0 = 不截断（推荐）。
# 这里不控长度——要短靠提示词里的长度纪律。真配了上限也只在句子边界切，
# 不会出现「我今天去了武汉科技大学，然后我们…」这种半句话。
DL_SENPAI_REPLY_HARD_MAX_CHARS=0

# ---- Agent 循环预算 ----
# 一轮 Agent 最多几步模型调用 / 最多执行几个工具。默认值是按"群聊 90 秒内
# 必须出声"定的；管理员私聊做多文件整理这类长任务时可以单独调高。
DL_SENPAI_AGENT_MAX_STEPS=4
DL_SENPAI_AGENT_MAX_TOOL_CALLS=8
# 同一「工具+参数」重复几次就停（防复读循环）
DL_SENPAI_AGENT_SAME_TOOL_REPEAT_LIMIT=2
# 整轮墙钟超时（秒），0 = 不限制
# 整轮墙钟超时。定 180 是因为生图实测要 78 秒，叠加模型思考后会贴近
# 90 秒的旧上限，导致"画到一半没影了"。普通对话用不到这么多，不影响。
DL_SENPAI_AGENT_TIMEOUT=180
# token 预算，0 = 不限制（默认）
DL_SENPAI_AGENT_TOKEN_BUDGET=0
# 原生 function calling（OpenAI tools 参数）。默认 false = 走 <<<MARKER>>> 文本协议
DL_SENPAI_AGENT_NATIVE_TOOLS=false

# 拟人化：口语样例 / 碎句发送 / 内心状态 / 群风格 / 记忆召回
DL_SENPAI_FEWSHOT_ENABLE=true
DL_SENPAI_HUMANIZE_SEND=true
DL_SENPAI_TYPING_DELAY_MS_MIN=400
DL_SENPAI_TYPING_DELAY_MS_MAX=1200
# 一次回复最多拆成几条气泡。1 = 不拆（推荐）：连发 2~3 条在群里像刷屏。
DL_SENPAI_BUBBLE_MAX=1
# 长度纪律注入到系统提示词最末（贴住本轮消息的位置才压得住输出长度）
DL_SENPAI_REPLY_BREVITY_ENABLE=true
# 消息合并窗口：对方连着发几条时，攒一小会儿再回一次。
# 跟上面的 BUBBLE_MAX 不是一回事：那个管「她的话拆几条」，这个管「对方的话攒几条」。
# 关掉后每条消息都单独回，遇到「那个 PPT / 就是上次说的 / 你有吗」会连答三次。
DL_SENPAI_BATCH_ENABLE=true
DL_SENPAI_BATCH_WINDOW_GROUP_MS=2500
DL_SENPAI_BATCH_WINDOW_PRIVATE_MS=1500
DL_SENPAI_BATCH_MAX_ITEMS=6
# 主人 QQ 号，逗号分隔。留空 = 没有主人，一切按概率和冷却走。
# 配了之后：这些人说话跳过冷却和骰子（但「嗯」「草」这类短句仍不走 AI）。
DL_SENPAI_OWNER_IDS=
DL_SENPAI_BUBBLE_MIN_CHARS=40
DL_SENPAI_BUBBLE_PREFER_CHARS=120
DL_SENPAI_INNER_STATE_ENABLE=true
DL_SENPAI_INNER_STATE_DIR=data/dl_senpai/inner_state
DL_SENPAI_INNER_STATE_PER_GROUP=true
DL_SENPAI_GROUP_STYLE_ENABLE=true
DL_SENPAI_GROUP_STYLE_DIR=data/dl_senpai/group_style
DL_SENPAI_GROUP_STYLE_TOP_N=8
DL_SENPAI_GROUP_STYLE_MIN_COUNT=3
DL_SENPAI_MEMORY_RECALL_ENABLE=true
DL_SENPAI_MEMORY_RECENT_TURNS=24
DL_SENPAI_MEMORY_RECALL_TOP=4

# ── 发送闸门（防风控，强烈建议保持开启）──
# 腾讯判断机器人最看的不是你打几个字，而是「失败之后还一直重试」。
# 这几个默认值是踩坑调出来的，别为了「响应更快」放大。
DL_SENPAI_SEND_BREAKER_ENABLE=true
DL_SENPAI_SEND_BREAKER_FAIL_THRESHOLD=3
DL_SENPAI_SEND_BREAKER_COOLDOWN_SEC=180
DL_SENPAI_SEND_RATE_PER_MINUTE=6
DL_SENPAI_SEND_RATE_PER_HOUR=80

# ── 真·「正在输入」（OneBot 扩展 set_input_status）──
# 上报太勤本身就是机器人特征（原项目一天 175 次，反而暴露了）。
# NapCat 不一定实现这个接口，探到不支持会自动永久关闭。
DL_SENPAI_TYPING_STATUS_ENABLE=true
DL_SENPAI_TYPING_STATUS_MIN_CHARS=20
DL_SENPAI_TYPING_STATUS_MIN_INTERVAL_SEC=45
DL_SENPAI_TYPING_STATUS_PROBABILITY=0.35
# 打字时长按字数算（真人手打约 110ms/字）；0 = 用固定延迟区间
DL_SENPAI_TYPING_MS_PER_CHAR=110
DL_SENPAI_TYPING_MS_MAX=3000

# ── 她自己的日记 ──
# 记忆是「关于你的事」，日记是「她自己的一天」，两者分开存。
# 只把最近 N 条喂进提示词；调大没有好处，会把她拽在旧事里接不上眼前的话。
DL_SENPAI_DIARY_ENABLE=true
DL_SENPAI_DIARY_DIR=data/dl_senpai/diary
DL_SENPAI_DIARY_CONTEXT_N=3
DL_SENPAI_DIARY_MAX_CHARS=600

# ── 她自己的生活（定时静默唤醒）──
# 默认关闭：这是唯一一种「没人开口她自己往外发消息」的能力。
# 打开后每 interval 秒问她一次「现在是你自己的时间，想干点什么」，
# 她自己可以选写日记 / 在群里冒一句 / 什么都不干。
DL_SENPAI_OWN_LIFE_ENABLE=false
DL_SENPAI_OWN_LIFE_INTERVAL_SEC=9000
DL_SENPAI_OWN_LIFE_MAX_PER_DAY=6
DL_SENPAI_OWN_LIFE_QUIET_START=3
DL_SENPAI_OWN_LIFE_QUIET_END=8
DL_SENPAI_OWN_LIFE_DIR=data/dl_senpai/own_life
# 允许她主动发言的群号（逗号分隔）。**留空 = 只写日记，绝不发消息**。
# 别把不相关的群加进来：既是防骚扰，也是防腾讯风控。
DL_SENPAI_OWN_LIFE_GROUPS=

# 逗号分隔群号，留空表示全部允许
DL_SENPAI_ALLOWED_GROUPS=
# 是否响应私聊
DL_SENPAI_ENABLE_PRIVATE=true
# 有人进群时学姐自动欢迎
DL_SENPAI_WELCOME_ENABLE=true

# 新人认证：进群后须 @学姐 发送「认证」，超时踢出（需学姐是群管）
DL_SENPAI_VERIFY_ENABLE=true
# 认证时限（秒），默认 600=10 分钟
DL_SENPAI_VERIFY_TIMEOUT_SEC=600
# 启用认证的群号，逗号分隔；留空=所有允许响应的群
DL_SENPAI_VERIFY_GROUPS=
DL_SENPAI_VERIFY_DIR=data/dl_senpai/verify

# 启动 bot.py 时是否一并拉起 Web 控制台前后端（Go:28473 / Vite:41788）
DL_SENPAI_CONSOLE_AUTOSTART=true

# 表情包：被动收集 + 回复时自动发送
DL_SENPAI_STICKER_ENABLE=true
DL_SENPAI_STICKER_COLLECT=true
DL_SENPAI_STICKER_DIR=data/dl_senpai/stickers
DL_SENPAI_STICKER_MAX_PER_SESSION=200
DL_SENPAI_STICKER_REPLY_PROB=0.22
DL_SENPAI_STICKER_REPLY_PROB_INTERRUPT=0.08

# 识图：解析群友发的图片并传给模型
DL_SENPAI_VISION_ENABLE=true
DL_SENPAI_VISION_MAX_IMAGES=3
DL_SENPAI_IMAGE_INTERRUPT_BOOST=0.06

# 语音：gptsovits=本地 GPT-SoVITS（推荐）；edge=Edge TTS 备用
DL_SENPAI_VOICE_ENABLE=true
DL_SENPAI_VOICE_PROVIDER=gptsovits
DL_SENPAI_GPTSOVITS_URL=http://127.0.0.1:9880
# 随 python bot.py 自动拉起 api_v2（若 9880 已有服务则复用）
DL_SENPAI_GPTSOVITS_AUTOSTART=true
DL_SENPAI_GPTSOVITS_HOME=GPT-SoVITS-v2pro-20250604
DL_SENPAI_GPTSOVITS_CONFIG=GPT_SoVITS/configs/tts_infer.yaml
DL_SENPAI_GPTSOVITS_STARTUP_TIMEOUT=180
DL_SENPAI_GPTSOVITS_REF_AUDIO=GPT-SoVITS-v2pro-20250604/angelina/ref.wav
# 与 ref.wav 对应（3~10 秒）；须和参考音频内容一致
# DL_SENPAI_GPTSOVITS_PROMPT_TEXT=あまりシラクーザ人っぽくないんだよね それに響も名前っぽくないってよく言われるから
DL_SENPAI_GPTSOVITS_PROMPT_LANG=ja
DL_SENPAI_GPTSOVITS_TEXT_LANG=zh
DL_SENPAI_GPTSOVITS_FALLBACK_EDGE=false
DL_SENPAI_VOICE_REPLY_PROB=0.12
DL_SENPAI_VOICE_MAX_CHARS=120
# Edge 备用（API 挂了时）
DL_SENPAI_VOICE_PROFILE=angelina

# 群名片：机器人需为群管；对方要求可改，聊到改名时可偶尔主动改
DL_SENPAI_CARD_ENABLE=true
DL_SENPAI_CARD_MAX_LEN=16
DL_SENPAI_CARD_PLAYFUL_COOLDOWN=600
DL_SENPAI_CARD_ALLOW_ON_INTERRUPT=true

# 禁言：被惹急时可短时禁言普通成员（需机器人是群管）
DL_SENPAI_MUTE_ENABLE=true
DL_SENPAI_MUTE_MIN_SEC=30
DL_SENPAI_MUTE_MAX_SEC=120
DL_SENPAI_MUTE_COOLDOWN=180
DL_SENPAI_MUTE_ALLOW_ON_INTERRUPT=false

# 热梗 / 热榜：TTL 缓存后注入学姐提示词（也可给 Cursor MCP 复用）
DL_SENPAI_TRENDS_ENABLE=true
# 默认用 uapis（本机可解析）；DailyHot 作备用
DL_SENPAI_TRENDS_BASE_URL=https://uapis.cn/api/v1/misc/hotboard
DL_SENPAI_TRENDS_FALLBACK_BASES=https://api-hot.imsyy.top
DL_SENPAI_TRENDS_SOURCES=weibo,douyin,bilibili,baidu,zhihu
DL_SENPAI_TRENDS_TTL_SEC=1800
DL_SENPAI_TRENDS_PER_SOURCE=8
DL_SENPAI_TRENDS_MAX_ITEMS=20
DL_SENPAI_TRENDS_PROMPT_MAX_CHARS=800
DL_SENPAI_TRENDS_CACHE_DIR=data/dl_senpai/trends

# 联网检索：模型写 <<<SEARCH query>>> 后本地检索再续答（也可给 Cursor MCP 复用）
DL_SENPAI_SEARCH_ENABLE=true
# 时效/事实类问题在调模型前自动联网（无需 <<<SEARCH>>>）
DL_SENPAI_SEARCH_AUTO=true
# 对像问事实/背景的消息更积极自动联网（类似网页版助手）
DL_SENPAI_SEARCH_AUTO_AGGRESSIVE=true
# auto | bing | duckduckgo | searxng | tavily
DL_SENPAI_SEARCH_PROVIDER=auto
DL_SENPAI_SEARCH_MAX_RESULTS=5
DL_SENPAI_SEARCH_MAX_ROUNDS=2
DL_SENPAI_SEARCH_TIMEOUT=12
# 整次检索的总预算：首轮 + 换词重试 + 时效补搜 + 抓正文，超时就用已拿到的部分结果
# 详情类问题（配装/参数/攻略）要开浏览器抓正文，给它留够时间
DL_SENPAI_SEARCH_DEADLINE=18
# 抓正文：单页超时与摘录长度（trafilatura 抽的是纯正文，900 字不至于白抓）
DL_SENPAI_SEARCH_PAGE_BODY_TIMEOUT=4
DL_SENPAI_SEARCH_PAGE_BODY_MAX_CHARS=900
DL_SENPAI_SEARCH_REGION=zh-cn
DL_SENPAI_SEARCH_PROMPT_MAX_CHARS=2400
# 插嘴时一般不联网（省延迟）
DL_SENPAI_SEARCH_ALLOW_ON_INTERRUPT=false
# 可选：自建 SearXNG 根地址，例如 https://searx.example
DL_SENPAI_SEARCH_SEARXNG_URL=
# 静态抓不到正文时开浏览器兜底（B站专栏这类 SPA 有效；知乎/贴吧有风控，会直接跳过）
DL_SENPAI_SEARCH_BROWSER_FALLBACK=true
# 可选：Tavily API Key（更稳）
DL_SENPAI_SEARCH_TAVILY_API_KEY=

# 生图：OpenAI 兼容 images API（默认复用 OPENAI_*；模型按中转站支持改）
DL_SENPAI_DRAW_ENABLE=true
DL_SENPAI_DRAW_MODEL=gpt-image-1
# 你的生图 Key 若只开通 gpt-image-2，改成 gpt-image-2；dall-e-3 需单独渠道
# DL_SENPAI_DRAW_API_KEY=
# DL_SENPAI_DRAW_BASE_URL=
DL_SENPAI_DRAW_SIZE=1024x1024
# 部分模型支持 standard/hd，不需要可留空
DL_SENPAI_DRAW_QUALITY=
DL_SENPAI_DRAW_TIMEOUT=120
DL_SENPAI_DRAW_COOLDOWN=0
DL_SENPAI_DRAW_MAX_PROMPT_CHARS=400
DL_SENPAI_DRAW_MAX_ARCHIVE=200
DL_SENPAI_DRAW_DIR=data/dl_senpai/draw
DL_SENPAI_DRAW_ALLOW_ON_INTERRUPT=false

# 角色身份管线：识别已知 IP 角色（艾雅法拉/凯尔希/初音未来…）并保住身份，
# 避免「画一张艾雅法拉」变成一张泛二次元羊角少女。关掉则退回纯文本生图。
DL_SENPAI_CHARACTER_ENABLE=true
# 低于这个置信度就当没认出来（例如只说了「小羊」而没提作品名）
DL_SENPAI_CHARACTER_MIN_CONFIDENCE=0.8
# 自定义角色档案目录（同 data/characters.json 结构，同名覆盖内置）
DL_SENPAI_CHARACTER_DIR=data/dl_senpai/characters
# 本地角色参考图库：<作品>/<角色>/ref_01.png（有图就用图生图，最稳）
DL_SENPAI_CHARACTER_REFERENCE_DIR=data/dl_senpai/character_references

# 生图调试：把每次生图的 trace（原话/识别结果/参考图/最终提示词/模型/耗时）
# 脱敏后落盘，用来回答「为什么画得不像」。生产环境保持 false。
DL_SENPAI_IMAGE_DEBUG=false
DL_SENPAI_IMAGE_TRACE_FILE=data/dl_senpai/draw_traces.jsonl

# 浏览器逛网站：Playwright 截图 / 淘宝搜商品 / Pixiv 搜图（需 pip install -e ".[browser]" && playwright install chromium）
DL_SENPAI_BROWSER_ENABLE=true
DL_SENPAI_BROWSER_DIR=data/dl_senpai/browser
DL_SENPAI_BROWSER_TIMEOUT=90
DL_SENPAI_BROWSER_COOLDOWN=30
DL_SENPAI_BROWSER_MAX_IMAGES=3
DL_SENPAI_BROWSER_HEADLESS=true
DL_SENPAI_BROWSER_VIEWPORT_WIDTH=1280
DL_SENPAI_BROWSER_VIEWPORT_HEIGHT=900
# 截图 URL 白名单，逗号分隔；空=任意公网 https；*=全部
DL_SENPAI_BROWSER_ALLOWED_DOMAINS=
DL_SENPAI_BROWSER_ALLOW_ON_INTERRUPT=false

# 社交：自动同意好友申请 / 被拉进群邀请（默认开）
# 注意：别人申请进群（需群管审核）永不自动同意，留给真人群管处理
DL_SENPAI_AUTO_ACCEPT_FRIEND=true
DL_SENPAI_AUTO_ACCEPT_GROUP=true
# DL_SENPAI_AUTO_ACCEPT_FRIEND_REMARK=

# 主动社交：遍历群成员发好友申请（默认关！防风控；每日配额内随机间隔发出）
# mode: auto=Cookie CGI 优先（全自动，推荐） / web=仅 Cookie / onebot=仅协议扩展
# 按群开关可在控制台「群功能开关」页覆盖；黑名单逗号分隔
DL_SENPAI_FRIEND_ADD_ENABLE=false
# DL_SENPAI_FRIEND_ADD_MODE=auto
# DL_SENPAI_FRIEND_ADD_DAILY_LIMIT=20
# DL_SENPAI_FRIEND_ADD_VERIFY_MSG=我是群里的学姐~
# DL_SENPAI_FRIEND_ADD_EXCLUDE=

# 主动社交：每日过点后给好友主页点赞（send_like，每人 ≤10 赞/天；默认关）
DL_SENPAI_LIKE_ENABLE=false
# DL_SENPAI_LIKE_DAILY_HOUR=10
# DL_SENPAI_LIKE_TIMES=10

# QQ 空间动态赞评（A 方案 onebot-qzone；bot.py 可一键拉起并 NapCat 登录）
DL_SENPAI_QZONE_ENABLE=false
# DL_SENPAI_QZONE_AUTOSTART=true
# DL_SENPAI_QZONE_DIR=onebot-qzone
# DL_SENPAI_QZONE_STARTUP_TIMEOUT=60
# DL_SENPAI_QZONE_BRIDGE_URL=http://127.0.0.1:5700
# DL_SENPAI_QZONE_ACCESS_TOKEN=
# DL_SENPAI_QZONE_SYNC_COOKIE=true
# DL_SENPAI_QZONE_DAILY_HOUR=10
# DL_SENPAI_QZONE_LIKE_ENABLE=true
# DL_SENPAI_QZONE_COMMENT_ENABLE=true
# DL_SENPAI_QZONE_LIKE_DAILY_LIMIT=30
# DL_SENPAI_QZONE_COMMENT_DAILY_LIMIT=10
# DL_SENPAI_QZONE_COMMENT_PROB=0.35
# DL_SENPAI_QZONE_COMMENT_TEMPLATES=好看！,冲！,学姐路过点个赞~,不错哦
# DL_SENPAI_QZONE_FEED_NUM=20

# 签到：仅白名单群启用（默认迎新群）
DL_SENPAI_CHECKIN_ENABLE=true
DL_SENPAI_CHECKIN_GROUPS=980229149,600478436,1050332675
DL_SENPAI_CHECKIN_DIR=data/dl_senpai/checkin
DL_SENPAI_CHECKIN_STICKER_PROB=0.35
DL_SENPAI_CHECKIN_SYNC_SPECIAL_TITLE=true

