DL_SENPAI_SHOP_AFFECTION_DISCOUNT_MAX_RATE=0.35

# 学姐 Web 控制台（admin/backend + admin/frontend）
# SENPAI_CONSOLE_PORT=28473
# SENPAI_CONSOLE_HOST=127.0.0.1
