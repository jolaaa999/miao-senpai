DL_SENPAI_SHOP_AFFECTION_DISCOUNT_ENABLE=true
DL_SENPAI_SHOP_AFFECTION_DISCOUNT_BASE_CHANCE=0.05
DL_SENPAI_SHOP_AFFECTION_DISCOUNT_CHANCE_PER_TIER=0.08
DL_SENPAI_SHOP_AFFECTION_DISCOUNT_MAX_CHANCE=0.75
DL_SENPAI_SHOP_AFFECTION_DISCOUNT_BASE_RATE=0.05
