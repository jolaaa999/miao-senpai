# SENPAI_CONSOLE_ADMIN_PASS=senpai2026
# SENPAI_CONSOLE_TOKEN_SECRET=change-me-in-production


# ================================================================
# 借鉴小黑盒 @异世回忆（QQ 小鲸鱼 / ai-companion-kit）后的进阶开关
#
# 全部默认关闭或最保守。每一条单独看都不复杂，但它们共同的特点是
# **打开之后她会更像个人，也更可能做出你没邀请的动作**，所以请按需开。
# ================================================================

# -- 她自己的生活：随机间隔 + 真发概率 + 不打断你们 --
# 旧键 DL_SENPAI_OWN_LIFE_INTERVAL_SEC 仍然有效（写了就按固定间隔走）。
DL_SENPAI_OWN_LIFE_INTERVAL_MIN_SEC=2700
# 45 分钟
DL_SENPAI_OWN_LIFE_INTERVAL_MAX_SEC=6600
# 110 分钟
DL_SENPAI_OWN_LIFE_SEND_PROBABILITY=0.35
# 想说话之后还要过这道骰子
DL_SENPAI_OWN_LIFE_MIN_SILENCE_SEC=900
# 你 15 分钟内说过话就不叫醒她

# -- 断线补课：重连后补上掉线期间的消息（只总结，不逐条回）--
DL_SENPAI_BACKFILL_ENABLE=false
DL_SENPAI_BACKFILL_MAX_MESSAGES=30
DL_SENPAI_BACKFILL_MAX_AGE_SEC=21600

# -- 语音转文字：只走本地 whisper，不联网 --
# 需要额外装依赖：pip install faster-whisper
# 没装时功能自动退化（日志里说一句，不影响聊天）。
DL_SENPAI_ASR_ENABLE=false
DL_SENPAI_ASR_MODEL=small
DL_SENPAI_ASR_LANGUAGE=zh
DL_SENPAI_ASR_TIMEOUT_SEC=90

# -- 她自己的相册（她挑的图 + 一句理由）--
DL_SENPAI_GALLERY_ENABLE=false
DL_SENPAI_GALLERY_MAX_ITEMS=200
DL_SENPAI_GALLERY_CONTEXT_N=3

# -- 印象保鲜：多久没更新就提醒她重新看这个人 --
DL_SENPAI_IMPRESSION_REFRESH_ENABLE=true
DL_SENPAI_IMPRESSION_REFRESH_DAYS=14

# -- 周报：每周一次「我们这周」（必须配群号才会真发）--
DL_SENPAI_WEEKLY_ENABLE=false
DL_SENPAI_WEEKLY_WEEKDAY=1
# 1=周一
DL_SENPAI_WEEKLY_HOUR=22
DL_SENPAI_WEEKLY_GROUPS=

# -- 开场白去重：同一种开头反复用时会提醒她换说法 --
DL_SENPAI_GREETING_DEDUPE_ENABLE=true
DL_SENPAI_GREETING_DEDUPE_WINDOW_SEC=21600

# ================================================================
# 电脑（GUI）操作 —— 默认关，开了也只是「只能看」
#
# ⚠ 不要接你的主力机。她拿到的是当前登录用户的完整桌面权限：
#   能点任何按钮、能在任何输入框里打字。请用安卓模拟器或一台备用机，
#   并且那台机器上不要装支付、银行、密码管理器。
#
# 三层围栏（缺一不可）：
#   1. MODE=control 才允许输入；默认 view 只能截图/看窗口
#   2. 前台窗口必须命中 ALLOW_APPS 白名单（留空 = 谁都不许碰）
#   3. 必须持有租约：python scripts\computer-lease.py allow 10
#      到期自动失效；忘了收也不会一直有效
# 另外：命中 DENY_KEYWORDS 的窗口（支付/密码类）连截图都会被拒。
# ================================================================
DL_SENPAI_COMPUTER_ENABLE=false
DL_SENPAI_COMPUTER_MODE=view
DL_SENPAI_COMPUTER_ALLOW_APPS=
DL_SENPAI_COMPUTER_DENY_KEYWORDS=
DL_SENPAI_COMPUTER_REQUIRE_LEASE=true
DL_SENPAI_COMPUTER_MAX_ACTIONS_PER_MIN=20
DL_SENPAI_COMPUTER_CLICK_MIN_INTERVAL_MS=300
DL_SENPAI_COMPUTER_SCREENSHOT_MAX_SIDE=1280


# -- 读链接：把对方贴的 URL 变成正文（网页/文章/PDF）--
# 默认开：不开的话她看到链接只能靠截图，或者凭 URL 里的英文猜。
DL_SENPAI_LINK_READ_ENABLE=true
DL_SENPAI_LINK_READ_AUTO=true
# 群里贴链接就自动先读一遍
DL_SENPAI_LINK_READ_USE_BROWSER=true
# 静态抽不出正文时开浏览器渲染（SPA 兜底）
DL_SENPAI_LINK_READ_MAX_CHARS=6000
# 喂给模型的正文上限，超出留首尾
DL_SENPAI_LINK_READ_MAX_BYTES=2097152
# 下载上限 2MB
DL_SENPAI_LINK_READ_TIMEOUT=20
DL_SENPAI_LINK_READ_CACHE_TTL_SEC=21600
DL_SENPAI_LINK_READ_ALLOWED_DOMAINS=       # 留空 = 除内网外都可以；内网永远禁
DL_SENPAI_LINK_READ_SUMMARY_ENABLE=true
# 长文先压成要点
DL_SENPAI_LINK_READ_SUMMARY_MIN_CHARS=4000
DL_SENPAI_LINK_READ_BROWSER_MIN_CHARS=400
# 浏览器渲染时"正文够了没"的门槛，低于就继续等


# -- B站 / 小黑盒：只读上网（刷视频、搜帖子）--
# 为什么默认开：只读、不用登录，最坏结果是"被站点限流"，不是"以她的名义发东西"。
# 写入类动作（发说说、发帖）是另一套开关，见 docs/social-web.md 的 T2。
DL_SENPAI_BILI_ENABLE=true
DL_SENPAI_BILI_DAILY_LIMIT=60
# 每天最多刷几次；0=不限
DL_SENPAI_BILI_TIMEOUT=15
DL_SENPAI_HEYBOX_ENABLE=true
DL_SENPAI_HEYBOX_DAILY_LIMIT=40
DL_SENPAI_HEYBOX_TIMEOUT=30
# 要真开浏览器渲染搜索页，给宽一点
DL_SENPAI_QUOTA_FILE=data/dl_senpai/quota.json
# 配额账本，按天清零


# -- 写入层：发说说 / 黑盒评论（默认全关，需要主人手动登录一次）--
# 这两个是「以她的名义在公开平台留痕」，发出去撤不回来，所以默认关 + 只对管理员可见。
DL_SENPAI_QZONE_ENABLE=false
# 打开才注册 qzone 工具
DL_SENPAI_QZONE_AUTO_POST=false
# false = 只存草稿，主人私聊说「发」才发
DL_SENPAI_QZONE_DAILY_LIMIT=1
# 每天最多几条
DL_SENPAI_QZONE_MAX_CHARS=120
DL_SENPAI_QZONE_DRAFT_FILE=data/dl_senpai/qzone_drafts.json
DL_SENPAI_HEYBOX_WRITE_ENABLE=false
# 打开才注册 heybox_write（评论）工具
DL_SENPAI_HEYBOX_COMMENT_DAILY_LIMIT=0
# 0 = 不按天卡条数；靠下面的间隔/同帖去重/文案去重来像人
DL_SENPAI_HEYBOX_COMMENT_MIN_GAP_SEC=600
DL_SENPAI_HEYBOX_WRITE_STATE_FILE=data/dl_senpai/heybox_write_state.json
DL_SENPAI_HEYBOX_BROWSE_ENABLE=false
# 她自己刷帖子的间隔（随机 1~3 小时）与"看完想说"的概率
DL_SENPAI_HEYBOX_BROWSE_INTERVAL_MIN_SEC=3600
DL_SENPAI_HEYBOX_BROWSE_INTERVAL_MAX_SEC=10800
DL_SENPAI_HEYBOX_BROWSE_COMMENT_PROBABILITY=0.35
DL_SENPAI_HEYBOX_BROWSE_LOG_FILE=data/dl_senpai/heybox_browse_log.jsonl
# 两次开浏览器的最小间隔（秒）：太密会被小黑盒判成脚本（实测 show_captcha）
DL_SENPAI_HEYBOX_SESSION_GAP_SEC=240
# 别人回她的留言，她要不要自己接话；一次回头看几篇帖子找留言
DL_SENPAI_HEYBOX_BROWSE_REPLY_ENABLE=true
DL_SENPAI_HEYBOX_INBOX_POSTS=1
DL_SENPAI_HEYBOX_COMMENT_MAX_CHARS=300
DL_SENPAI_WEB_LOGIN_DIR=data/dl_senpai/web_login
# 登录态目录，等同于密码，别提交
DL_SENPAI_WEB_LOGIN_GUARD_OWNER=true
# 登录的是主人主号就拒收


# -- 观测：每条请求一行 trace 摘要（默认开）--
# 输出形如 agent.request_summary trace=... mode=runtime reply_by=runtime
#   stop=finished model_calls=2 usage=3210 tools="search:success:812ms" ...
# 只写元数据（工具名/耗时/计数/状态），不写用户原话、不写回复正文。
# 线上排查「这条为什么进了 Agent / 为什么调这个工具 / 最后谁生成的回复」靠它。
DL_SENPAI_AGENT_TRACE_SUMMARY=true


# -- MCP 内向接入：把外部 MCP Server 的工具接给她用（默认关）--
#
# 注意方向：仓库里的 mcp_servers/ 是「把她的能力导出给 Cursor」，
# 这一段是「让她去调别人的工具」，两者方向相反、可以同时存在。
#
# 前置条件：必须同时开 DL_SENPAI_AGENT_NATIVE_TOOLS=true。
# 第三方工具没有 marker 协议可用，只能走原生 tool calling 暴露；
# 只开 MCP 不开 native tools 时会在启动日志里看到 mcp.blocked 并跳过。
DL_SENPAI_MCP_ENABLE=false
# 两种写法二选一：
#   1) 直接写 JSON（兼容从 Cursor/AstrBot 拷来的 mcpServers 外壳）
#   2) 指向一个 JSON 文件
# 例：DL_SENPAI_MCP_SERVERS={"web":{"command":"python","args":["-m","my_mcp"]}}
DL_SENPAI_MCP_SERVERS=
DL_SENPAI_MCP_CONFIG=
DL_SENPAI_MCP_INIT_TIMEOUT=30
DL_SENPAI_MCP_TOOL_TIMEOUT=30
# 合计工具上限，防止一次接入几十个工具把上下文预算吃光；0=不限
DL_SENPAI_MCP_MAX_TOOLS=40
# 默认只对管理员可见：MCP 是第三方进程，能力边界未知，不该默认开放给全群。
DL_SENPAI_MCP_TOOLS_ADMIN_ONLY=true
# 逗号分隔的服务器名，运行期单独屏蔽（不必改整段 JSON）
DL_SENPAI_MCP_DISABLED_SERVERS=


# -- 技能层（Skills）：按需给她塞一页领域说明书（默认关）--
#
# 定位：技能 **只是文本**，不执行任何东西、不注册工具。
# 她真需要动手时走工具层（search/draw/browse...），技能只教她"这类任务怎么做"。
#
# 为什么值得开：人设提示词是全局的，"做 PPT 先定大纲、只用一个强调色"这种
# 领域规范写进去会污染闲聊，不写又每次临场发挥。技能只在该出现的那回合出现。
#
# 存储：<技能目录>/<名字>/SKILL.md，开头可选 frontmatter：
#     ---
#     name: ppt-design
#     description: 做 PPT 的版式与配色规范
#     triggers: ppt, 幻灯片, 演示文稿
#     ---
#     正文……
# 没有 triggers 的技能永远不会自动注入（避免变成常驻提示词）。
DL_SENPAI_SKILL_ENABLE=false
DL_SENPAI_SKILL_DIR=data/skills
# 单条技能正文注入上限（字）。太长会稀释注意力，也会抢人设的戏份。
DL_SENPAI_SKILL_MAX_CHARS=1500
# 单条消息最多注入几个技能。默认 1：两个领域规范同时上，模型会互相打架。
DL_SENPAI_SKILL_MAX_SKILLS=1
# 热重载：改完 SKILL.md 立刻生效，不必重启 bot（每轮只 stat 一次目录，开销可忽略）
DL_SENPAI_SKILL_HOT_RELOAD=true

# ---- B站（要先用小号登录：python scripts\login-web.py bili）----
# 发评论 / 回留言总开关；没有登录态时它只会报错
DL_SENPAI_BILI_WRITE_ENABLE=false
# 留言轮询：官方消息接口，一次 GET，半小时一次足够
DL_SENPAI_BILI_INBOX_ENABLE=false
DL_SENPAI_BILI_INBOX_INTERVAL_SEC=1800
DL_SENPAI_BILI_INBOX_MAX_PER_TICK=2
DL_SENPAI_BILI_INBOX_LOG_FILE=data/dl_senpai/bili_inbox_log.jsonl
# 两条评论最小间隔（秒）；0 = 不按天卡条数
DL_SENPAI_BILI_COMMENT_MIN_GAP_SEC=900
DL_SENPAI_BILI_COMMENT_DAILY_LIMIT=0
DL_SENPAI_BILI_COMMENT_MAX_CHARS=200
DL_SENPAI_BILI_WRITE_STATE_FILE=data/dl_senpai/bili_write_state.json
# 养号：每天登录+看视频+分享攒经验（Lv2 才能评论）。B站协议不允许自动化，风险自负
DL_SENPAI_BILI_GROW_ENABLE=false
DL_SENPAI_BILI_GROW_HOUR=12
DL_SENPAI_BILI_GROW_COINS=0
DL_SENPAI_BILI_GROW_LOG_FILE=data/dl_senpai/bili_grow_log.jsonl
