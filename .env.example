DL_SENPAI_PERSON_MEMORY_MAX_TRAITS=16
DL_SENPAI_PERSON_MEMORY_MAX_NOTE_CHARS=400
DL_SENPAI_PERSON_MEMORY_ALLOW_ON_INTERRUPT=false

